# Copy to backend/.env for local development (never commit real secrets)
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DATABASE_URL=postgres://echo:echo@localhost:5432/echo
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Fernet key for per-user API keys stored in the database (required in production; dev derives
# one from SECRET_KEY). Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ECHO_FIELD_ENCRYPTION_KEY=
# ECHO_AI_PROVIDER=fake   # use recorded responses instead of calling providers
# Spoken question (TTS): model, voices and steering per language
# ECHO_TTS_MODEL=gpt-4o-mini-tts
# ECHO_TTS_VOICE_EN=marin
# ECHO_TTS_VOICE_FR=cedar
# ECHO_TTS_INSTRUCTIONS_EN=
# ECHO_TTS_INSTRUCTIONS_FR=
# Text models used when a user's calls go through OpenAI (own OpenAI key only)
# ECHO_OPENAI_EVALUATION_MODEL=gpt-6-astra
# ECHO_OPENAI_GENERATION_MODEL=gpt-6-sol
# ECHO_OPENAI_IMPROVED_ANSWER_MODEL=gpt-6-sol
